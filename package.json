{
  "name": "blackbox-analyzer",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "rsw watch & vite",
    "build": "rsw build && run-p type-check build-only",
    "build:gh-pages": "rsw build && env DEPLOYMENT=gh-pages vite build --outDir docs",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint src --fix",
    "rsw": "rsw",
    "test": "vitest run"
  },
  "dependencies": {
    "@lucide/vue": "^1.48.0",
    "leaflet": "^1.9.4",
    "pinia": "^3.0.1",
    "vue": "^3.5.13",
    "vue-router": "^5.0.6"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^25.6.2",
    "@types/wicg-file-system-access": "^2023.10.5",
    "@typescript-eslint/parser": "^8.59.2",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-vue": "^10.9.1",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.8.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^7.3.3",
    "vite-plugin-rsw": "^2.0.11",
    "vitest": "^5.0.3",
    "vue-eslint-parser": "^10.4.0",
    "vue-tsc": "^3.3.12"
  }
}
